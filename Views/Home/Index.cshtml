    <div class="container text-center">
        <h2>Ready to Build Something Powerful?</h2>
        <p>Let’s transform your ideas into scalable digital products.</p>
        <a asp-page="/Contact" class="btn-primary">Start Your Project</a>
    </div>
</section>

