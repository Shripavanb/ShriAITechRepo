@{
    ViewData["Title"] = "Home";
}
<link href="~/css/index.css" rel="stylesheet" />
<!-- HERO SECTION -->
<section class="hero">
    <div class="container hero-container">
        <div class="hero-text">
            <h1>Innovative Digital Solutions Powered by AI</h1>
            <p>
                Shri AI Tech delivers modern web, cloud, and AI-powered
                solutions to help businesses grow faster and smarter.
            </p>
            <div class="hero-buttons">
                <a asp-action="Portfolio" class="btn-primary">View Portfolio</a>
                <a asp-action="ContactUs" class="btn-secondary">Contact Us</a>
            </div>
        </div>

     @*    <div class="hero-image">
            <img src="~/img/Services - Copy.png" alt="Tech Illustration" />
        </div> *@
    </div>
</section>

<!-- ABOUT SECTION -->
<section class="about">
    <div class="container about-container">
        <div class="about-text">
            <h2>Who We Are</h2>
            <p>
                We are a technology-driven company focused on building scalable,
                secure, and intelligent digital platforms. From startups to enterprises,
                we deliver tailored solutions that create measurable impact.
            </p>
        </div>
    </div>
</section>

<!-- SERVICES SECTION -->
<section class="services">
    <div class="container">
        <h2 class="section-title">Our Core Services</h2>
        <div class="services-grid">

            <div class="service-card">
                <h3>Web Development</h3>
                <p>High-performance websites & web applications built using modern frameworks.</p>
            </div>

            <div class="service-card">
                <h3>Cloud Solutions</h3>
                <p>Secure cloud infrastructure, deployment & scalable architecture.</p>
            </div>

            <div class="service-card">
                <h3>AI & Machine Learning</h3>
                <p>Smart automation, predictive analytics & intelligent systems.</p>
            </div>

            <div class="service-card">
                <h3>Mobile App Development</h3>
                <p>Android & cross-platform mobile apps for seamless user experiences.</p>
            </div>

        </div>
    </div>
</section>

<!-- WHY CHOOSE US -->
<section class="why-us">
    <div class="container">
        <h2 class="section-title">Why Choose Shri AI Tech?</h2>
        <div class="why-grid">
            <div class="why-card">
                <h4>✔ Modern Technology</h4>
                <p>We use the latest frameworks & scalable architecture.</p>
            </div>

            <div class="why-card">
                <h4>✔ Secure & Reliable</h4>
                <p>Security-first development and enterprise-grade reliability.</p>
            </div>

            <div class="why-card">
                <h4>✔ Client-Focused</h4>
                <p>We build solutions aligned with your business goals.</p>
            </div>
        </div>
    </div>
</section>

<!-- CALL TO ACTION -->
