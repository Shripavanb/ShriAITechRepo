<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Shri AI Tech</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

</head>
<body>

    <!-- Header -->
    <header class="main-header">
        <div class="container nav-container">
            <div class="logo">
                <img src="~/img/logos/NewLogo.png" width="100" height="100" />
                @* <img src="~/img/logos/chatgpt image feb 12, 2026, 09_34_15 pm.png" width="150" height="100" /> *@
                <a asp-page="/Index">Shri<span>AI</span>Tech</a>
            </div>

            <nav class="nav-menu">
                <a asp-page="/Index">Home</a>
                <a asp-page="/Portfolio">Portfolio</a>
                <a asp-page="/Services">Services</a>
                <a asp-page="/Contact">Contact</a>
            </nav>

            <div class="nav-cta">
                <a asp-page="/Contact" class="btn-primary">Get Quote</a>
            </div>
        </div>
    </header>

    <!-- Page Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container footer-grid">
            <div>
                <h3>Shri AI Tech</h3>
                <p>Building intelligent digital solutions with modern technology.</p>
            </div>

            <div>
                <h4>Services</h4>
                <ul>
                    <li>Web Development</li>
                    <li>Cloud Solutions</li>
                    <li>AI & Machine Learning</li>
                    <li>App Development</li>
                </ul>
            </div>

            <div>
                <h4>Contact</h4>
                <p>Hyderabad, India</p>
                <p>Email: info@shriaitech.in</p>
            </div>
        </div>

        <div class="footer-bottom">
            © @DateTime.Now.Year Shri AI Tech. All rights reserved.
        </div>
    </footer>

</body>
</html>
