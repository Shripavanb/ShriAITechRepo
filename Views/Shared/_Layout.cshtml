<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Shri AI Tech</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

</head>
<body>

    <!-- Header -->
    <header class="main-header">
        <div class="container nav-container">
            <div class="logo">
                <img src="~/img/logos/NewLogo.png" width="98" height="100" />
                <a asp-page="/Index">Shri<span>AI</span>Tech</a>
            </div>

            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <a asp-action="Index">Home</a>
                <a asp-action="Products">Products</a>
                <a asp-action="Portfolio">Portfolio</a>
                <a asp-action="ContactUs">Contact</a>
                <a asp-action="AboutUs">AboutUs</a>
                <a asp-action="JoinUs">JoinUs</a>
            </nav>

            <div class="nav-cta">
                <a asp-action="ContactUs" class="btn-primary">Get Quote</a>
            </div>
        </div>
    </header>

    <!-- Page Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container footer-grid">
            <div>
                <h3>Shri AI Tech</h3>
                <p>Building intelligent digital solutions with modern technology.</p>
            </div>

            <div>
                <h4>Services</h4>
                <ul>
                    <li>Web Development</li>
                    <li>Cloud Solutions</li>
                    <li>AI & Machine Learning</li>
                    <li>App Development</li>
                </ul>
            </div>
            <div>
                <h4>Branches</h4>
                <ul>
                    <li>Hyderabad, India</li>
                    <li><a href="https://shriaitech.uk/" target="_blank" style="color: #f1f5f9cc">UK</a></li>
                    <li><a href="https://shriaitech.com/" target="_blank" style="color: #f1f5f9cc">USA</a></li>
                </ul>
            </div>
            <div>
                <h4>Contact</h4>
                <p>Hyderabad, India</p>
                <p>Email: shripavanb@shriaitech.in</p>
            </div>
        </div>

        <div class="footer-bottom">
            © @DateTime.Now.Year Shri AI Tech. All rights reserved.
        </div>
    </footer>

</body>
</html>
